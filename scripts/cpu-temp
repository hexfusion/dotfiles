#!/bin/bash
# Find the CPU package sensor dynamically. Driver name differs by vendor:
# k10temp on AMD (Framework 16), coretemp on Intel (ThinkPad P1).
for driver in k10temp coretemp; do
for hwmon in /sys/class/hwmon/hwmon*; do
    if [ "$(cat "$hwmon/name" 2>/dev/null)" = "$driver" ]; then
        temp=$(cat "$hwmon/temp1_input" 2>/dev/null)
        if [ -n "$temp" ]; then
            # Convert to Fahrenheit
            c=$((temp / 1000))
            f=$(( (c * 9 / 5) + 32 ))
            echo "{\"text\": \"󰔏 ${f}°F\", \"class\": \"$([ $c -ge 85 ] && echo critical || echo normal)\"}"
            exit 0
        fi
    fi
done
done
echo '{"text": "󰔏 --", "class": "error"}'
