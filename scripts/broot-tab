#!/bin/bash
# broot-tab: persistent broot per zellij tab
export EDITOR=vim
export VISUAL=vim
export PATH="$HOME/.local/bin:$PATH"

BROOT="$HOME/.local/bin/broot"
STATE_FILE="$HOME/.config/zellij/broot-dirs"
mkdir -p "$(dirname "$STATE_FILE")"
touch "$STATE_FILE"

get_tab_name() {
    "$HOME/.local/bin/zellij" action dump-layout 2>/dev/null \
        | grep 'focus=true' \
        | head -1 \
        | sed 's/.*name="\([^"]*\)".*/\1/'
}

tab_name=$(get_tab_name)
saved_dir=$(grep "^${tab_name}	" "$STATE_FILE" 2>/dev/null | tail -1 | cut -f2)

start_dir="${saved_dir:-$HOME/projects}"
[ ! -d "$start_dir" ] && start_dir="$HOME"

while true; do
    tmpfile=$(mktemp)
    "$BROOT" "$start_dir" --outcmd "$tmpfile"

    if [ -s "$tmpfile" ]; then
        new_dir=$(sed 's/^cd //' "$tmpfile" | tr -d "'\"")
    else
        new_dir="$start_dir"
    fi

    if [ -n "$new_dir" ] && [ -n "$tab_name" ]; then
        grep -v "^${tab_name}	" "$STATE_FILE" > "$STATE_FILE.tmp" 2>/dev/null
        echo "${tab_name}	${new_dir}" >> "$STATE_FILE.tmp"
        mv "$STATE_FILE.tmp" "$STATE_FILE"
    fi

    rm -f "$tmpfile"
    [ -n "$new_dir" ] && start_dir="$new_dir"
done
