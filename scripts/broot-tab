#!/bin/bash
# broot-tab: workspace-scoped broot per zellij tab
# Usage: broot-tab [workspace-name]
# Reads broot_root from ~/.config/workbench/workspaces.yaml
# Falls back to ~/projects if workspace not found

export EDITOR=/home/sbatsche/.local/bin/zellij-edit
export VISUAL="$EDITOR"
export PATH="$HOME/.local/bin:$PATH"

BROOT="$HOME/.local/bin/broot"
CONFIG="$HOME/.config/workbench/workspaces.yaml"
DEFAULT_ROOT="$HOME/projects"

TAB_NAME="$1"
export WORKBENCH_TAB="$TAB_NAME"

get_broot_root() {
    local tab="$1"
    if [ -n "$tab" ] && [ -f "$CONFIG" ]; then
        local root
        root=$(yq -r ".workspaces.\"$tab\".broot_root // .defaults.broot_root // \"\"" "$CONFIG" 2>/dev/null)
        root="${root/#\~/$HOME}"
        if [ -n "$root" ] && [ -d "$root" ]; then
            echo "$root"
            return
        fi
    fi
    echo "$DEFAULT_ROOT"
}

start_dir=$(get_broot_root "$TAB_NAME")
exec "$BROOT" "$start_dir"
