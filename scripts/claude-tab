#!/bin/bash
# claude-tab: Claude Code session persistence per zellij tab
#
# Design:
#   - Per-tab session files: ~/.config/zellij/claude-sessions/<tab-name>
#     Each file contains one UUID. No shared map, no concurrent write race.
#   - Session ID generated upfront (uuidgen), passed via --session-id
#   - exec (foreground) — no backgrounding, no polling, no watchers
#   - Tab name comes from $1 (layout arg) — never guessed
#
# Usage:
#   claude-tab <tab-name>

set -euo pipefail

SESSION_DIR="$HOME/.config/zellij/claude-sessions"
mkdir -p "$SESSION_DIR"

tab_name="${1:-}"
[ -z "$tab_name" ] && { echo "error: usage: claude-tab <tab-name>" >&2; exit 1; }

[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && PATH="$HOME/.local/bin:$PATH"

zellij action rename-tab "$tab_name" 2>/dev/null || true

# Resolve Claude project dir from cwd
project_dir=$(echo "$PWD" | sed 's|^/||; s|/|-|g')

session_exists() {
    local sid="$1"
    [ -f "$HOME/.claude/projects/-${project_dir}/${sid}.jsonl" ] || \
    [ -f "$HOME/.claude/projects/${project_dir}/${sid}.jsonl" ]
}

session_file="$SESSION_DIR/$tab_name"

# Try to resume existing session
if [ -f "$session_file" ]; then
    session_id=$(cat "$session_file")
    if [ -n "$session_id" ] && session_exists "$session_id"; then
        echo "Resuming '$tab_name' (${session_id:0:8}...)"
        exec claude --resume "$session_id" -n "$tab_name"
    fi
    echo "Stale session for '$tab_name', starting fresh..."
fi

# New session — generate ID, save, launch
session_id=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)
echo "$session_id" > "$session_file"
echo "Starting '$tab_name' (${session_id:0:8}...)"
exec claude --session-id "$session_id" -n "$tab_name"
