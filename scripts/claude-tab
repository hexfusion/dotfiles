#!/bin/bash
# claude-tab: start or resume claude sessions tied to zellij tab names
# Usage:
#   claude-tab              # resume if session exists for this tab, otherwise start new
#   claude-tab <name>       # rename tab to <name>, then resume or start new

SESSION_MAP="$HOME/.config/zellij/claude-sessions"
mkdir -p "$(dirname "$SESSION_MAP")"
touch "$SESSION_MAP"

get_tab_name() {
    zellij action dump-layout 2>/dev/null \
        | grep 'focus=true' \
        | head -1 \
        | sed 's/.*name="\([^"]*\)".*/\1/'
}

save_session() {
    local tab_name="$1"
    local session_id="$2"
    grep -v "^${tab_name}	" "$SESSION_MAP" > "$SESSION_MAP.tmp" 2>/dev/null
    echo "${tab_name}	${session_id}" >> "$SESSION_MAP.tmp"
    mv "$SESSION_MAP.tmp" "$SESSION_MAP"
}

remove_session() {
    local tab_name="$1"
    grep -v "^${tab_name}	" "$SESSION_MAP" > "$SESSION_MAP.tmp" 2>/dev/null
    mv "$SESSION_MAP.tmp" "$SESSION_MAP"
}

lookup_session() {
    grep "^${1}	" "$SESSION_MAP" | tail -1 | cut -f2
}

latest_session_id() {
    local project_dir
    project_dir=$(echo "$PWD" | sed 's|/|-|g')
    ls -t ~/.claude/projects/"$project_dir"/*.jsonl 2>/dev/null \
        | head -1 \
        | sed 's|.*/\(.*\)\.jsonl|\1|'
}

# Background watcher: polls tab name every 5s, updates mapping if renamed
watch_tab_name() {
    local current_name="$1"
    local session_id="$2"
    while kill -0 "$3" 2>/dev/null; do
        sleep 5
        new_name=$(get_tab_name)
        if [ -n "$new_name" ] && [ "$new_name" != "$current_name" ]; then
            remove_session "$current_name"
            save_session "$new_name" "$session_id"
            current_name="$new_name"
        fi
    done
}

# Rename tab if name provided
if [ -n "$1" ]; then
    zellij action rename-tab "$1" 2>/dev/null
    tab_name="$1"
else
    tab_name=$(get_tab_name)
fi

# Try to resume existing session for this tab
session_id=$(lookup_session "$tab_name")
if [ -n "$session_id" ]; then
    echo "Resuming session for tab '$tab_name'..."
    claude --resume "$session_id" -n "$tab_name" &
    claude_pid=$!
else
    echo "Starting new session for tab '$tab_name'..."
    claude -n "$tab_name" &
    claude_pid=$!
fi

# Wait briefly for claude to create its session file, then get the ID
sleep 2
active_session_id=$(latest_session_id)
if [ -n "$active_session_id" ]; then
    save_session "$tab_name" "$active_session_id"
    # Start watcher in background
    watch_tab_name "$tab_name" "$active_session_id" "$claude_pid" &
    watcher_pid=$!
fi

# Wait for claude to exit
wait "$claude_pid" 2>/dev/null

# Kill watcher
kill "$watcher_pid" 2>/dev/null

# Final save with current tab name
exit_tab_name=$(get_tab_name)
new_session_id=$(latest_session_id)
if [ -n "$new_session_id" ] && [ -n "$exit_tab_name" ]; then
    if [ "$exit_tab_name" != "$tab_name" ] && [ -n "$tab_name" ]; then
        remove_session "$tab_name"
    fi
    save_session "$exit_tab_name" "$new_session_id"
fi
