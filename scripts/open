#!/usr/bin/env bash
# Open a file in Chrome: open /path/to/file
set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "usage: open <file>..." >&2
    exit 1
fi

args=()
for f in "$@"; do
    # Resolve to absolute path so Chrome finds relative files
    if [[ -e "$f" ]]; then
        args+=("$(realpath "$f")")
    else
        args+=("$f")
    fi
done

exec google-chrome "${args[@]}" >/dev/null 2>&1
